+// Move a cursor to the pilot or HAR `id` on `page`.
+static void place_cursor(cursor_data *cursor, selection_page page, unsigned id) {
+    // note: id can be 10 or more (HAR_NOVA, HAR_OCELOT, the hacked robots, PILOT_KREISSACK, PILOT_JAGUAR,
+    // PILOT_TIGER, the World Championship's pilots) when returning from VS. The robot pages have cells
+    // for Nova, Ocelot and the hacked ones, the pilot pages for Jaguar, Tiger and the tournament's; there
+    // are none for Kreissack,
+    // which the original game handles surprisingly elegantly. If we try to naively do that, our
+    // pointers all explode.
+    cursor->pilot_page = 0;
+    if(id >= HAR_TIGRIS && id < NUMBER_OF_HAR_TYPES && page == HAR_SELECT) {
+        cursor->pilot_page = 1;
+        cursor->row = (id - HAR_TIGRIS) / 6;
+        cursor->column = (id - HAR_TIGRIS) % 6;
+    } else if(id >= HAR_NOVA && page == HAR_SELECT) {
+        cursor->column = EXTRA_COLUMN;
+        cursor->row = id - HAR_NOVA;
+    } else if(id >= PILOT_TOURNAMENT_FIRST && id < NUMBER_OF_PILOT_TYPES && page == PILOT_SELECT) {
+        int n = id - PILOT_TOURNAMENT_FIRST;
+        cursor->pilot_page = 1 + n / PILOTS_PER_PAGE;
+        cursor->row = n % PILOTS_PER_PAGE / 6;
+        cursor->column = n % 6;
+    } else if(id >= PILOT_JAGUAR && id < PILOT_TOURNAMENT_FIRST && page == PILOT_SELECT) {
+        cursor->column = EXTRA_COLUMN;
+        cursor->row = id - PILOT_JAGUAR;
+    } else {
+        id = id >= 10 ? (page == HAR_SELECT ? HAR_FLAIL : PILOT_CRYSTAL) : id;
+        cursor->column = id % 5;
+        cursor->row = id / 5;
+    }
+    cursor->done = 0;
+}
