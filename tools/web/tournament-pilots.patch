+#include "game/utils/tournament_pilots.h"
+#include "formats/bk.h"
+#include "formats/error.h"
+#include "formats/pic.h"
+#include "game/common_defines.h"
+#include "resources/languages.h"
+#include "resources/resource_files.h"
+#include "resources/trnmanager.h"
+#include "utils/c_string_util.h"
+#include "utils/log.h"
+#include <ctype.h>
+#include <stdio.h>
+#include <string.h>
+
+static sd_tournament_file world;
+static int count = -1; // -1: not loaded yet
+static const sd_pilot *pilots[TOURNAMENT_PILOTS]; // NULL: no such pilot
+static sd_pilot secrets[2];                        // Fire and Ice
+static char upper_names[TOURNAMENT_PILOTS][32];
+static char bios[TOURNAMENT_PILOTS][128];
+static int sexes[TOURNAMENT_PILOTS];
+static vga_palette robot_palettes[TOURNAMENT_PILOTS]; // color 16: the robot in the colors drawn for it
+
+static bool same_name(const char *a, const char *b);
+
+// Jaguar's and Tiger's robots wear ramps of the World Championship's robots, as their photos keep
+// them: per ramp (tertiary, secondary, primary) the pilot and the ramp it is taken from.
+static const struct {
+    int pilot_id;
+    const char *from[3];
+    int ramp[3];
+} coats[] = {
+    {PILOT_JAGUAR, {"Bethany", "Raven", "ICEMAN"}, {1, 2, 0}},     // sand, near black, gold
+    {PILOT_TIGER, {"Angel", "Raven", "Eva Earlong"}, {0, 2, 0}},   // silver white, near black, orange
+};
+#define COATS (int)(sizeof(coats) / sizeof(coats[0]))
+static vga_palette coat_palettes[COATS];
+
+static int coat_of(int pilot_id) {
+    for(int i = 0; i < COATS; i++) {
+        if(coats[i].pilot_id == pilot_id) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+// The original ten fight in the World Championship too; those are not pilots of their own.
+static bool is_original(const sd_pilot *p) {
+    for(int id = 0; id < NUMBER_OF_PLAYABLE_PILOT_TYPES; id++) {
+        if(same_name(str_c(&p->name), pilot_get_name(id))) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Fire and Ice, the single player game's secret opponents: no WORLD.TRN entry, no photo. They fight
+// as the World Championship's best, and their robots wear the colors the Fire Pit gives them when
+// they come: the fire of its second palette, the ice of its third's sky.
+static void add_secrets(const sd_pilot *best) {
+    sd_bk_file pit;
+    sd_bk_create(&pit);
+    const path filename = get_resource_filename("ARENA3.BK");
+    bool has_pit = sd_bk_load(&pit, &filename) == SD_SUCCESS && pit.palettes[1] && pit.palettes[2];
+    static const struct {
+        int name_str; // the language file's name
+        int har_id;
+        int sex;
+        const char *quote;
+        const char *bio;
+    } secret[2] = {
+        {189, HAR_KATANA, PILOT_SEX_MALE, "Few reach the fire. Fewer walk out of it.",
+         "The Fire Pit's secret challenger. Its Katana is painted in flames and has every upgrade."},
+        {190, HAR_SHADOW, PILOT_SEX_FEMALE, "After the fire, the ice.",
+         "The last secret of the Fire Pit. Its Shadow is as clear as ice and has every upgrade."},
+    };
+    for(int i = 0; i < 2; i++) {
+        int n = PILOT_FIRE + i - PILOT_TOURNAMENT_FIRST;
+        sd_pilot *p = &secrets[i];
+        sd_pilot_clone(p, best);
+        char name[32]; // "FIRE" as "Fire"
+        snprintf(name, sizeof(name), "%s", lang_get(secret[i].name_str));
+        for(char *c = name + 1; *c; c++) {
+            *c = tolower((unsigned char)*c);
+        }
+        str_set_c(&p->name, name);
+        str_set_c(&p->quotes[0], secret[i].quote);
+        p->har_id = secret[i].har_id;
+        p->power = p->agility = p->endurance = 30; // the top of the select screen's scale
+        p->secret = 1;
+        snprintf(upper_names[n], sizeof(upper_names[n]), "%s", lang_get(secret[i].name_str));
+        snprintf(bios[n], sizeof(bios[n]), "%s", secret[i].bio);
+        sexes[n] = secret[i].sex;
+        if(has_pit) {
+            for(int k = 0; k < 48; k++) {
+                robot_palettes[n].colors[k] = i == 0 ? pit.palettes[1]->colors[k] : pit.palettes[2]->colors[48 + k % 16];
+            }
+        }
+        pilots[n] = p;
+    }
+    sd_bk_free(&pit);
+}
+
+static void load(void) {
+    if(count >= 0) {
+        return;
+    }
+    count = 0;
+    if(trn_load(&world, "WORLD.TRN") != 0) {
+        return;
+    }
+
+    // female or male: the photo says
+    sd_pic_file pic;
+    sd_pic_create(&pic);
+    const path filename = get_resource_filename("WORLD.PIC");
+    bool has_pic = sd_pic_load(&pic, &filename) == SD_SUCCESS;
+
+    for(int e = 0; has_pic && e < world.enemy_count; e++) {
+        const sd_pic_photo *photo = sd_pic_get(&pic, world.enemies[e]->photo_id);
+        for(int i = 0; photo && i < COATS; i++) {
+            for(int r = 0; r < 3; r++) {
+                if(same_name(str_c(&world.enemies[e]->name), coats[i].from[r])) {
+                    memcpy(&coat_palettes[i].colors[r * 16], &photo->pal.colors[coats[i].ramp[r] * 16],
+                           16 * sizeof(vga_color));
+                }
+            }
+        }
+    }
+
+    int rank = 0;
+    for(int e = 0; e < world.enemy_count && count < PILOT_FIRE - PILOT_TOURNAMENT_FIRST; e++) {
+        const sd_pilot *p = world.enemies[e];
+        if(!p->secret) {
+            rank++;
+        }
+        if(is_original(p)) {
+            continue;
+        }
+        int n = count++;
+        pilots[n] = p;
+        snprintf(upper_names[n], sizeof(upper_names[n]), "%s", str_c(&p->name));
+        for(char *c = upper_names[n]; *c; c++) {
+            *c = toupper((unsigned char)*c);
+        }
+        const sd_pic_photo *photo = has_pic ? sd_pic_get(&pic, p->photo_id) : NULL;
+        sexes[n] = photo && photo->sex ? PILOT_SEX_FEMALE : PILOT_SEX_MALE;
+        if(photo) {
+            robot_palettes[n] = photo->pal;
+        }
+        const char *robot = p->har_id < NUMBER_OF_HAR_TYPES ? har_get_name(p->har_id) : "any";
+        if(p->secret) {
+            snprintf(bios[n], sizeof(bios[n]), "A secret challenger of the World Championship. Robot: %s.", robot);
+        } else {
+            snprintf(bios[n], sizeof(bios[n]), "World Championship, ranked %d. Robot: %s.", rank, robot);
+        }
+    }
+    if(has_pic) {
+        sd_pic_free(&pic);
+    }
+    if(world.enemy_count > 0) {
+        add_secrets(world.enemies[0]); // the world champion
+    }
+    count = TOURNAMENT_PILOTS;
+    log_info("Tournament pilots: %d from WORLD.TRN, Fire and Ice", PILOT_FIRE - PILOT_TOURNAMENT_FIRST);
+}
+
+static int index_of(int pilot_id) {
+    load();
+    int n = pilot_id - PILOT_TOURNAMENT_FIRST;
+    return n >= 0 && n < count && pilots[n] ? n : -1;
+}
+
+const sd_pilot *tournament_pilot_get(int pilot_id) {
+    int n = index_of(pilot_id);
+    return n < 0 ? NULL : pilots[n];
+}
+
+const char *tournament_pilot_upper_name(int pilot_id) {
+    int n = index_of(pilot_id);
+    return n < 0 ? "" : upper_names[n];
+}
+
+const char *tournament_pilot_bio(int pilot_id) {
+    int n = index_of(pilot_id);
+    return n < 0 ? "" : bios[n];
+}
+
+int tournament_pilot_sex(int pilot_id) {
+    int n = index_of(pilot_id);
+    return n < 0 ? PILOT_SEX_MALE : sexes[n];
+}
+
+// Names compared on their letters only: "Jean-Paul" is WORLD.TRN's "Jean Paul".
+static bool same_name(const char *a, const char *b) {
+    for(;;) {
+        while(*a && !isalpha((unsigned char)*a)) {
+            a++;
+        }
+        while(*b && !isalpha((unsigned char)*b)) {
+            b++;
+        }
+        if(!*a || !*b) {
+            return !*a && !*b;
+        }
+        if(toupper((unsigned char)*a++) != toupper((unsigned char)*b++)) {
+            return false;
+        }
+    }
+}
+
+const char *tournament_pilot_quote_by_name(const char *name) {
+    load();
+    for(int n = 0; count > 0 && n < world.enemy_count; n++) {
+        if(same_name(str_c(&world.enemies[n]->name), name) && str_size(&world.enemies[n]->quotes[0]) > 0) {
+            return str_c(&world.enemies[n]->quotes[0]);
+        }
+    }
+    return NULL;
+}
+
+void tournament_pilot_set_player_color(sd_pilot *pilot, int pilot_id, player_color index, uint8_t color) {
+    int n = index_of(pilot_id);
+    int coat = coat_of(pilot_id);
+    if(color != 16 || (n < 0 && coat < 0)) {
+        sd_pilot_set_player_color(pilot, index, color);
+        return;
+    }
+    switch(index) {
+        case TERTIARY:
+            pilot->color_3 = color;
+            break;
+        case SECONDARY:
+            pilot->color_2 = color;
+            break;
+        case PRIMARY:
+            pilot->color_1 = color;
+            break;
+    }
+    const vga_palette *from = n >= 0 ? &robot_palettes[n] : &coat_palettes[coat];
+    memcpy(&pilot->palette.colors[index * 0x10], &from->colors[index * 0x10], 0x10 * sizeof(vga_color));
+}
