@@ -0,0 +1,26 @@
+#ifndef TOURNAMENT_PILOTS_H
+#define TOURNAMENT_PILOTS_H
+
+#include "formats/pilot.h"
+
+// Web build: the World Championship's pilots (WORLD.TRN), playable in one and two player
+// games as pilot ids PILOT_TOURNAMENT_FIRST and up, in the tournament's order. Their faces
+// and icons are in MELEE.BK and VS.BK at those ids (tools/web/tournament/trnfaces.c).
+
+// The pilot as WORLD.TRN has it; NULL for the other pilots (or without WORLD.TRN).
+const sd_pilot *tournament_pilot_get(int pilot_id);
+
+// Name as the score board spells it, bio for the select screen, and female or male.
+const char *tournament_pilot_upper_name(int pilot_id);
+const char *tournament_pilot_bio(int pilot_id);
+int tournament_pilot_sex(int pilot_id);
+
+// What the pilot named `name` says in the World Championship (the original pilots are in it
+// too); NULL if nobody there has that name.
+const char *tournament_pilot_quote_by_name(const char *name);
+
+// A player color as sd_pilot_set_player_color() sets it, except that 16 takes the tournament
+// pilot's own colors (from its photo in WORLD.PIC, as the tournament does).
+void tournament_pilot_set_player_color(sd_pilot *pilot, int pilot_id, player_color index, uint8_t color);
+
+#endif // TOURNAMENT_PILOTS_H
